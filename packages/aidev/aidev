#!/usr/bin/env bash
#
# aidev - run an AI harness inside a devcontainer for the current project.
#
# Normally invoked through one of its harness symlinks, which drop you straight
# into that harness in yolo mode, starting the container first if needed:
#
#   claude [args...]     pi [args...]
#
# The workspace is managed directly with:
#
#   aidev up [dir]       start the container without attaching
#   aidev status [dir]   print workspace id, state and ssh host
#   aidev list           list every workspace by the directory it belongs to
#   aidev ls             alias for list
#   aidev stop [dir]     stop the container, keep the workspace
#   aidev rm [dir]       delete the workspace
#   aidev rebuild [dir]  rebuild the image and recreate the container
#   aidev shell [dir]    escape hatch: interactive shell in the container
#
# Each workspace is anchored at the directory where it is started. Running from
# a repository subdirectory therefore creates a container for that subdirectory.

set -euo pipefail

# Pinned runtime dependencies. Nix rewrites this at build time; left empty the
# script still works from a checkout, using whatever is already on PATH.
AIDEV_RUNTIME_PATH=""
if [[ -n "$AIDEV_RUNTIME_PATH" ]]; then
    export PATH="$AIDEV_RUNTIME_PATH:$PATH"
fi

IMAGE="${AIDEV_IMAGE:-ghcr.io/erickuck/ai-devcontainer:latest}"
CONFIG_DIR=".devcontainer"
# Fallback config directory for a repository that tracks .devcontainer/ itself.
ALT_CONFIG_DIR=".aidev"

# Upstream config cache – refreshed explicitly on rebuild so everyday runs
# stay fast and offline-friendly.
AIDEV_CACHE_DIR="${HOME}/.cache/aidev"

die() { printf 'aidev: %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }

command -v devpod >/dev/null || die "devpod is not installed"

# The yolo invocation for each harness. pi has no such flag.
harness_flags() {
    case "$1" in
        claude) printf '%s\0' --dangerously-skip-permissions ;;
        pi) ;;
        *) die "unknown harness: $1" ;;
    esac
}

# ---------------------------------------------------------------- dispatch
#
# Invoked as `claude`/`pi` via symlink, or as `aidev <subcommand>`.

self="$(basename "$0")"
harness=""
subcommand=""

if [[ "$self" != "aidev" ]]; then
    harness="$self"
else
    case "${1:-}" in
        up|status|stop|rm|rebuild|shell) subcommand="$1"; shift ;;
        list|ls) subcommand="list"; shift ;;
        -h|--help|"") sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die "unknown command: $1" ;;
    esac
fi

# Listing spans every workspace, so it runs before the per-workspace resolution
# below rather than from the subcommand dispatch: that path refuses to treat
# $HOME as a workspace root, and `aidev list` has to work from anywhere.
if [[ "$subcommand" == "list" ]]; then
    [[ $# -eq 0 ]] || die "usage: aidev list"
    workspaces="$(devpod list --output json 2>/dev/null || true)"
    if [[ -n "$workspaces" ]]; then
        # `<directory>\t<id>`: the directory first because that is how you think
        # about a workspace, the id second because `rm` accepts it and it is the
        # only handle that still works once the directory is deleted. A workspace
        # with no local folder (e.g. created straight from a git URL) shows "-"
        # rather than dropping out of the listing.
        printf '%s' "$workspaces" \
            | jq -r '.[] | [(.source.localFolder // "-"), .id] | @tsv' \
            | sort
    fi
    exit 0
fi

# Harness args are passed through; subcommands take an optional directory.
if [[ -n "$harness" ]]; then
    start_dir="$PWD"
else
    start_dir="${1:-$PWD}"
fi

# Commands that only ever act on an already-existing workspace take a selector
# rather than a live directory: a workspace id as printed by `aidev ls`, or the
# directory it belongs to. That directory need not still exist -- deleting a
# project must not strand its container -- so the `-d` guard below is scoped to
# the commands that actually have to mount something.
case "$subcommand" in
    rm|stop|status) takes_selector=1 ;;
    *)              takes_selector=0 ;;
esac

# Looks a workspace up in DevPod's registry by id or by the directory it belongs
# to, printing `<id>\t<localFolder>`. aidev creates workspaces under the derived
# id below, but one created by anything else carries whatever id its creator
# chose, so deriving an id would simply miss it.
registered_workspace() {
    devpod list --output json 2>/dev/null \
        | jq -r --arg sel "$1" \
            '[.[] | select(.id == $sel or .source.localFolder == $sel)][0]
             | if . then [.id, (.source.localFolder // "")] | @tsv else empty end' \
            2>/dev/null || true
}

# Set here only when the selector resolved against the registry; otherwise it is
# derived further below, once `workspace_id` is defined.
id=""

if (( takes_selector )) && [[ ! -d "$start_dir" ]]; then
    entry="$(registered_workspace "$start_dir")"
    [[ -n "$entry" ]] || die "no workspace matches '$start_dir'
    it is neither an existing directory nor a workspace id; run 'aidev ls'"
    id="${entry%%$'\t'*}"
    root="${entry#*$'\t'}"
    start_dir="$root"
else
    # Resolve symlinks so the mounted path is the same inside and outside the
    # container. In particular, macOS resolves /tmp beneath /private/tmp.
    [[ -d "$start_dir" ]] || die "not a directory: $start_dir"
    start_dir="$(cd "$start_dir" && pwd -P)"

    # -------------------------------------------------------- workspace root
    #
    # The requested directory is the workspace root. Do not widen it to the git
    # root: starting aidev from a subdirectory intentionally creates a distinct
    # container whose mount contains only that subtree.

    root="$start_dir"

    [[ "$root" != "$HOME" && "$root" != "/" ]] \
        || die "refusing to use $root as a workspace; run this inside a project"
fi

# Build a readable id from the full path using fish-style abbreviation: each
# parent directory contributes its initial and the final directory stays whole.
# For example, /Users/eric/Code/acme/api becomes u-e-c-a-api. Keep the id short
# enough for the SSH hostname; unusually long names get a stable path hash.
workspace_id() {
    local path="${root#/}"
    local candidate=""
    local component normalized piece hash
    local -a components
    local i last

    IFS='/' read -r -a components <<< "$path"
    last=$((${#components[@]} - 1))

    for ((i = 0; i <= last; i++)); do
        component="${components[$i]}"
        normalized="$(printf '%s' "$component" \
            | tr '[:upper:]' '[:lower:]' \
            | tr -c 'a-z0-9' '-')"
        while [[ "$normalized" == *--* ]]; do normalized="${normalized//--/-}"; done
        normalized="${normalized#-}"; normalized="${normalized%-}"
        [[ -n "$normalized" ]] || continue

        if ((i == last)); then
            piece="$normalized"
        else
            piece="${normalized:0:1}"
        fi
        candidate="${candidate:+$candidate-}$piece"
    done

    [[ -n "$candidate" ]] || candidate="workspace"
    if ((${#candidate} > 48)); then
        hash="$(printf '%s' "$root" | git hash-object --stdin)"
        candidate="${candidate:0:39}-${hash:0:8}"
    fi

    printf '%s' "$candidate"
}

# A selector command prefers whatever id DevPod already registered for this
# directory, so it can act on a workspace aidev did not create. The creation
# paths keep deriving, so they never silently adopt and reconfigure someone
# else's workspace.
if [[ -z "$id" ]] && (( takes_selector )); then
    entry="$(registered_workspace "$root")"
    [[ -z "$entry" ]] || id="${entry%%$'\t'*}"
fi
[[ -n "$id" ]] || id="$(workspace_id)"
ssh_host="${id}.devpod"

# The upstream devcontainer.json uses ${localWorkspaceFolder} for its bind-
# mount, so the caller's cwd maps to the identical absolute path inside the
# container -- which is what makes dragged-in file paths resolve.
remote_dir="$start_dir"

workspace_state() {
    devpod status "$id" --output json 2>/dev/null \
        | jq -r '.state // "NotFound"' 2>/dev/null || echo NotFound
}

# aidev owns its config directory: it regenerates every file in there on each
# run and hides the directory in .git/info/exclude. A project that ships its own
# .devcontainer/ for VS Code -- a common shape -- would have its committed
# scripts silently reverted to the upstream cache and any file added there made
# invisible to git status. Generate into $ALT_CONFIG_DIR instead and point
# DevPod at it, so a tracked .devcontainer/ is left alone.
if git -C "$root" rev-parse --git-dir >/dev/null 2>&1 \
    && [[ -n "$(git -C "$root" ls-files -- "$CONFIG_DIR" 2>/dev/null | head -1)" ]]; then
    CONFIG_DIR="$ALT_CONFIG_DIR"
    devcontainer_path_args=(--devcontainer-path "$CONFIG_DIR/devcontainer.json")
else
    devcontainer_path_args=()
fi

# Refuse the unlikely case where two paths abbreviate to the same id rather
# than quietly attaching to the wrong workspace.
workspace_source() {
    devpod list --output json 2>/dev/null \
        | jq -r --arg id "$id" '.[] | select(.id == $id) | .source.localFolder // empty' \
            2>/dev/null || true
}

claimed="$(workspace_source)"
if [[ -n "$claimed" && "$claimed" != "$root" ]]; then
    die "workspace '$id' already belongs to $claimed
    run 'aidev rm' there first, or rename one of the directories"
fi

# ------------------------------------------------------------------- config
#
# The upstream devcontainer.json, initialize.sh, and post-create.sh are cached
# in ~/.cache/aidev/ and copied into the workspace's .devcontainer/ every time.
# The image and container names are set explicitly so a manual rebuild and
# DevPod always use the same tag, and Docker uses the abbreviated workspace id
# as the container name. The upstream files contain ${localWorkspaceFolder} for
# the bind mount.
#
# Refreshed explicitly via `aidev rebuild`.

# The upstream sources live in `devcontainer/`, not `.devcontainer/`, so that
# aidev's own generated `.devcontainer/` never collides with them in a checkout
# of that repository.
AIDEV_UPSTREAM_REPO="https://github.com/EricKuck/ai-devcontainer.git"
AIDEV_UPSTREAM_URL="https://raw.githubusercontent.com/EricKuck/ai-devcontainer/main/devcontainer"

refresh_upstream_config() {
    mkdir -p "$AIDEV_CACHE_DIR"
    log "fetching upstream devcontainer config"
    curl -sfL "$AIDEV_UPSTREAM_URL/devcontainer.json" > "$AIDEV_CACHE_DIR/devcontainer.json"
    curl -sfL "$AIDEV_UPSTREAM_URL/initialize.sh"     > "$AIDEV_CACHE_DIR/initialize.sh"
    curl -sfL "$AIDEV_UPSTREAM_URL/post-create.sh"    > "$AIDEV_CACHE_DIR/post-create.sh"
}

rebuild_image() {
    log "building fresh image without cache: $IMAGE"
    docker build \
        --pull \
        --no-cache \
        --tag "$IMAGE" \
        "$AIDEV_UPSTREAM_REPO#main:devcontainer"
}

write_config() {
    local container_name="$id"

    mkdir -p "$root/$CONFIG_DIR"

    # On first run the cache won't exist yet; fetch it now.
    if [[ ! -f "$AIDEV_CACHE_DIR/devcontainer.json" ]]; then
        refresh_upstream_config
    fi

    if [[ "$CONFIG_DIR" != ".devcontainer" ]]; then
        log "$root tracks .devcontainer/ in git; generating into $CONFIG_DIR/ instead"
    fi

    # The lifecycle hooks are workspace-relative, so they have to follow the
    # config directory when it moves off .devcontainer/.
    jq \
        --arg image "$IMAGE" \
        --arg container_name "$container_name" \
        --arg config_dir "$CONFIG_DIR" \
        '.image = $image
         | .name = $container_name
         | .runArgs = ((.runArgs // []) + ["--name", $container_name])
         | (if has("initializeCommand")
            then .initializeCommand = $config_dir + "/initialize.sh" else . end)
         | (if has("postCreateCommand")
            then .postCreateCommand = $config_dir + "/post-create.sh" else . end)' \
        "$AIDEV_CACHE_DIR/devcontainer.json" > "$root/$CONFIG_DIR/devcontainer.json"
    cp "$AIDEV_CACHE_DIR/initialize.sh"  "$root/$CONFIG_DIR/"
    cp "$AIDEV_CACHE_DIR/post-create.sh" "$root/$CONFIG_DIR/"
    chmod +x "$root/$CONFIG_DIR/initialize.sh" "$root/$CONFIG_DIR/post-create.sh"

    if git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
        local exclude exclude_entry
        exclude="$(git -C "$root" rev-parse --absolute-git-dir)/info/exclude"
        exclude_entry="/$(git -C "$root" rev-parse --show-prefix)$CONFIG_DIR/"
        mkdir -p "$(dirname "$exclude")"
        grep -Fqx -- "$exclude_entry" "$exclude" 2>/dev/null \
            || printf '%s\n' "$exclude_entry" >> "$exclude"
    fi
}

ensure_up() {
    local state
    state="$(workspace_state)"
    [[ "$state" == "Running" ]] && return 0
    write_config
    log "starting $id ($state)"
    devpod up "$root" --id "$id" --ide none \
        ${devcontainer_path_args[@]+"${devcontainer_path_args[@]}"} >&2
}

# ------------------------------------------------------------ supacode bridge
#
# Supacode drives an agent session over two independent channels.
#
# Presence and notifications are OSC 3008 escape sequences the agent hooks write
# to the tty, so they ride the ssh connection for free. The hooks themselves are
# already in the container - Supacode installs them into ~/.claude and ~/.pi,
# both of which the devcontainer bind-mounts - and they gate themselves on
# SUPACODE_SURFACE_ID, so forwarding it is what wakes them up.
#
# The `supacode` CLI instead speaks JSON over a unix socket owned by the mac
# app, which only reaches the container as a reverse forward.
#
# SUPACODE_SOCKET_PATH is deliberately NOT forwarded. The hooks append the
# agent's pid to their presence signal whenever it is set, and the app probes
# that pid against the host process table, where a container pid either pins a
# badge that never clears or reaps a live one. The bridge travels as
# SUPACODE_BRIDGE_SOCKET, which only the CLI reads.

SUPACODE_VARS=(
    SUPACODE_SURFACE_ID
    SUPACODE_TAB_ID
    SUPACODE_WORKTREE_ID
    SUPACODE_REPO_ID
    SUPACODE_ROOT_PATH
    SUPACODE_WORKTREE_PATH
)

# Reverse-forwarded socket files outlive the session that created them. Sweeping
# them in the remote command costs nothing; a second ssh round trip would.
supacode_sweep="find /tmp -maxdepth 1 -name 'supacode-bridge-*.sock' -mtime +1 -delete 2>/dev/null; "

ssh_opts=(-t)
remote_env=()

# Fills ssh_opts and remote_env for a session launched from a Supacode
# terminal. Outside Supacode none of these are set and this is a no-op.
supacode_session_setup() {
    local var
    for var in "${SUPACODE_VARS[@]}"; do
        [[ -n "${!var:-}" ]] && remote_env+=("$var=${!var}")
    done

    [[ -S "${SUPACODE_SOCKET_PATH:-}" ]] || return 0

    # Unique per invocation, so concurrent sessions in one container never
    # collide on the bind and a leftover file never blocks a new forward.
    local bridge="/tmp/supacode-bridge-$$-${RANDOM}.sock"
    ssh_opts+=(-R "$bridge:$SUPACODE_SOCKET_PATH")
    remote_env+=("SUPACODE_BRIDGE_SOCKET=$bridge")
}

# ------------------------------------------------------- keep the mac awake
#
# The agent runs in the container but the power assertion has to be held on the
# mac, and the container has no way to reach the host by design. The signal
# crosses as a file in a bind-mounted directory, the same trick the clipboard
# bridge uses: the harness hooks touch it when a turn starts and delete it when
# the turn ends, and the watcher below mirrors it onto a `caffeinate` child.
#
# Hooks create the file on prompt/tool-use and remove it only on stop, so the
# gaps between tool calls inside one turn never flap the assertion.
#
# `caffeinate -i` blocks idle *system* sleep only: the display still sleeps on
# its usual schedule and closing the lid still sleeps the machine.

AIDEV_ACTIVITY_DIR="${HOME}/.aidev/activity"
# Absolute path, so the bind mount resolves identically on both sides.
activity_file="$AIDEV_ACTIVITY_DIR/${id}-$$.busy"

# Global rather than a local of the watcher: the EXIT trap fires after the
# function has returned, where a local is already out of scope and `set -u`
# would abort the trap and leak the caffeinate it was meant to kill.
keepawake_caffeinated=""

keepawake_release() {
    [[ -n "${keepawake_caffeinated:-}" ]] || return 0
    kill "$keepawake_caffeinated" 2>/dev/null || true
    keepawake_caffeinated=""
}

# Polls the session's activity file for as long as `watched_pid` lives. That pid
# is aidev's own, which `exec ssh` below turns into the ssh process, so the
# watcher retires exactly when the session ends and takes the flag with it.
keepawake_watch() {
    local watched_pid="$1"
    trap 'keepawake_release; rm -f "$activity_file"' EXIT
    trap 'exit 0' TERM INT
    while kill -0 "$watched_pid" 2>/dev/null; do
        if [[ -e "$activity_file" ]]; then
            if [[ -z "${keepawake_caffeinated:-}" ]] \
                || ! kill -0 "$keepawake_caffeinated" 2>/dev/null; then
                # `-w` is the backstop: caffeinate exits with the ssh session even
                # if this watcher is SIGKILLed and never runs its trap.
                /usr/bin/caffeinate -i -w "$watched_pid" &
                keepawake_caffeinated=$!
            fi
        else
            keepawake_release
        fi
        sleep 5
    done
}

# Arms the watcher for this session. A stale flag from a killed predecessor is
# cleared first so the mac never starts out pinned awake.
keepawake_setup() {
    [[ -x /usr/bin/caffeinate ]] || return 0
    mkdir -p "$AIDEV_ACTIVITY_DIR"
    rm -f "$activity_file"
    remote_env+=("AIDEV_ACTIVITY_FILE=$activity_file")
    keepawake_watch "$$" &
}

# Renders remote_env as %q-quoted assignments for the remote `env` call.
remote_env_args() {
    local kv out=""
    if (( ${#remote_env[@]} > 0 )); then
        for kv in "${remote_env[@]}"; do
            out+=" $(printf '%q' "$kv")"
        done
    fi
    printf '%s' "$out"
}

# --------------------------------------------------------------- subcommands

case "$subcommand" in
    status)  printf '%s\t%s\t%s\t%s\n' "$id" "$(workspace_state)" "$ssh_host" "$root"; exit 0 ;;
    stop)    exec devpod stop "$id" ;;
    rm)
        devpod delete "$id" --force
        # Only remove files we put there – .devcontainer/ may have user content.
        # The guard is load-bearing now that a selector can name a workspace whose
        # directory is gone: an empty or missing $root would aim these deletes at
        # /.devcontainer instead.
        if [[ -n "$root" && -d "$root" ]]; then
            rm -f "$root/$CONFIG_DIR/devcontainer.json" \
                  "$root/$CONFIG_DIR/initialize.sh" \
                  "$root/$CONFIG_DIR/post-create.sh"
            rmdir "$root/$CONFIG_DIR" 2>/dev/null || true
        fi
        exit 0
        ;;
    up)      ensure_up; log "$id ready at $ssh_host"; exit 0 ;;
    rebuild)
        # Implicitly rm first so the workspace is clean. Unlike `rm`, a missing
        # workspace is not an error here: rebuild's job is to end up with a fresh
        # container, and starting from nothing already satisfies that.
        devpod delete "$id" --force || true
        rm -f "$root/$CONFIG_DIR/devcontainer.json" \
              "$root/$CONFIG_DIR/initialize.sh" \
              "$root/$CONFIG_DIR/post-create.sh"
        rmdir "$root/$CONFIG_DIR" 2>/dev/null || true

        refresh_upstream_config
        rebuild_image
        write_config
        log "rebuilding $id"
        devpod up "$root" --id "$id" --ide none --recreate \
            ${devcontainer_path_args[@]+"${devcontainer_path_args[@]}"} >&2
        exit 0
        ;;
    shell)
        ensure_up
        supacode_session_setup
        exec ssh "${ssh_opts[@]}" "$ssh_host" \
            "${supacode_sweep}cd $(printf '%q' "$remote_dir") && exec env$(remote_env_args) \"\$SHELL\" -l"
        ;;
esac

# ------------------------------------------------------------------- harness

ensure_up
supacode_session_setup
# Only the harness path arms this: `aidev shell` is an interactive shell, not an
# agent turn, and nothing there would ever clear the flag.
keepawake_setup

# Build the remote command: cd to the mirrored cwd, then exec the harness with
# its yolo flags plus whatever the caller passed. Everything is %q-quoted so
# arguments containing spaces survive the trip through ssh's remote shell.
remote="${supacode_sweep}cd $(printf '%q' "$remote_dir") && exec env"
remote+="$(remote_env_args)"
remote+=" $(printf '%q' "$harness")"

while IFS= read -r -d '' flag; do
    remote+=" $(printf '%q' "$flag")"
done < <(harness_flags "$harness")

for arg in "$@"; do
    remote+=" $(printf '%q' "$arg")"
done

exec ssh "${ssh_opts[@]}" "$ssh_host" "$remote"
